{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Guitar Tuner",
  "version": "0.1.0",
  "identifier": "com.moritzbrantner.tauri-template.guitar-tuner",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1422",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Guitar Tuner",
        "width": 680,
        "height": 760,
        "minWidth": 420,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:* http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": false
  }
}
